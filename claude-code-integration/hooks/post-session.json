{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "skill-forge hook post-commit --mode portfolio-bullet",
            "async": true
          }
        ]
      }
    ]
  }
}
