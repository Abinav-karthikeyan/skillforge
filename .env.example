# Copy to `.env` (project root) or `~/.skill-forge/.env` - both are gitignored.
# The tool loads project-root .env first, then ~/.skill-forge/.env as a fallback.
# Shell environment variables always win over both files.

# --- LLM provider keys ------------------------------------------------
# Set whichever your skill-forge.config.yaml references via ${VAR}:
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# TOGETHER_API_KEY=...
# FIREWORKS_API_KEY=...

# --- Optional: Gist sharing (needs `gist` scope only) -----------------
GITHUB_TOKEN=ghp_...
