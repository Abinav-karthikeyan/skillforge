{
  "name": "career-mode",
  "version": "0.1.0",
  "description": "Turn your coding sessions into interview-ready stories, portfolio bullets, and technical deep-dive Q&A",
  "main": "dist/index.js",
  "bin": {
    "career-mode": "./dist/index.js",
    "career-mode-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc && node -e \"require('fs').cpSync('src/prompts','dist/prompts',{recursive:true})\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "mcp": "tsx src/mcp/server.ts"
  },
  "keywords": [
    "career",
    "interview",
    "claude-code",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "openai": "^6.42.0",
    "uuid": "^14.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
