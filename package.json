{
  "name": "@abhinavravich1999/skill-forge",
  "version": "0.2.0",
  "description": "Turn your coding sessions into interview-ready stories, portfolio bullets, and technical deep-dive Q&A",
  "main": "dist/index.js",
  "bin": {
    "skill-forge": "dist/index.js",
    "skill-forge-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "skill-forge.config.yaml"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && node -e \"require('fs').cpSync('src/prompts','dist/prompts',{recursive:true})\"",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [
    "career",
    "interview",
    "mcp",
    "claude-code",
    "ai",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abinav-karthikeyan/skillforge.git"
  },
  "bugs": {
    "url": "https://github.com/Abinav-karthikeyan/skillforge/issues"
  },
  "homepage": "https://github.com/Abinav-karthikeyan/skillforge#readme",
  "engines": {
    "node": ">=20"
  },
  "author": "Abinav Karthikeyan",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@notionhq/client": "^5.25.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "openai": "^6.42.0",
    "uuid": "^14.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "workspaces": [
    "packages/codeintel"
  ]
}
